# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SHUTDOWN_TIMEOUT_MS=25000

# Bounded outbound requests. Multi-page crawl requests are additionally limited
# by the API to 50 pages, depth 5, and a 60-second per-host delay ceiling.
REQUEST_TIMEOUT_MS=10000
MAX_HTML_BYTES=2000000
USER_AGENT=AI-Visibility-Lab/1.0

# Storage: JSON is convenient locally. Use SQLite plus a persistent disk for a
# single production instance. SQLITE_PATH overrides DATA_DIR when provided.
STORAGE_ADAPTER=json
DATA_DIR=./data
# SQLITE_PATH=./data/research.sqlite

# Optional AI interpretation remains disabled unless both configuration and a
# reviewed provider adapter are supplied. No provider adapter ships by default.
AI_INTERPRETATION_ENABLED=false
AI_PROVIDER=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1200
AI_MAX_EVIDENCE_ITEMS=100
AI_MAX_INPUT_CHARACTERS=30000
